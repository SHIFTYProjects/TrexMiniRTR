# Prefetch - Correlated File Timestamps
G-H "Prefetch" { 
    $pf = dir C:\Windows\Prefetch\*.pf -EA 0|Sort LastWriteTime -D
    $res = $pf | % { 
        $created  = Format-DFIRDate $_.CreationTime
        $modified = Format-DFIRDate $_.LastWriteTime
        
        if($modified -ne "N/A"){ Add-TL -t $modified -macb "M..." -a "Prefetch-Modified" -u "SYSTEM" -d $_.Name -mod $modified -birth $created }
        if($created -ne "N/A"){ Add-TL -t $created -macb "...B" -a "Prefetch-Created" -u "SYSTEM" -d $_.Name -birth $created -mod $modified }
        
        [pscustomobject]@{ PrefetchFile=$_.Name; CreatedTime=$created; ModifiedTime=$modified }
    }
    $res | ConvertTo-Html -Fragment 
}

# User Profiles - Correlated Folder & Account Timestamps
G-H "Profiles" { 
    $fDirs = dir C:\Users -Dir | % {
        $created  = Format-DFIRDate $_.CreationTime
        $modified = Format-DFIRDate $_.LastWriteTime
        
        if($created -ne "N/A"){ Add-TL -t $created -macb "...B" -a "UserProfile-Created" -u $_.Name -d "User profile folder created" -birth $created -mod $modified }
        if($modified -ne "N/A"){ Add-TL -t $modified -macb "M..." -a "UserProfile-Modified" -u $_.Name -d "User profile folder modified" -mod $modified -birth $created }
        
        [pscustomobject]@{ Name=$_.Name; CreatedTime=$created; ModifiedTime=$modified }
    }
    
    $lAccts = Get-LocalUser | % {
        $lastLogon = Format-DFIRDate $_.LastLogon
        if($lastLogon -ne "N/A"){ Add-TL -t $lastLogon -macb ".A.." -a "LocalAccount-Logon" -u $_.Name -d "Last interactive logon timestamp" -acc $lastLogon }
        [pscustomobject]@{ Name=$_.Name; Enabled=$_.Enabled; LastLogon=$lastLogon }
    }
    "<h3>Folders</h3>$($fDirs|ConvertTo-Html -Fragment)<h3>Accounts</h3>$($lAccts|ConvertTo-Html -Fragment)" 
}

# Downloads - Full Side-by-Side MACB File Timestamps
G-H "Downloads" { 
    $d=@()
    dir C:\Users -Dir | % { 
        $uName=$_.Name
        dir "$($_.FullName)\Downloads" -File -EA 0 | % { 
            $created  = Format-DFIRDate $_.CreationTime
            $modified = Format-DFIRDate $_.LastWriteTime
            $accessed = Format-DFIRDate $_.LastAccessTime
            $desc = "$($_.Name) ($([math]::Round($_.Length/1KB,2)) KB)"
            
            if($created -ne "N/A"){ Add-TL -t $created -macb "...B" -a "Download-Created" -u $uName -d $desc -birth $created -mod $modified -acc $accessed }
            if($modified -ne "N/A"){ Add-TL -t $modified -macb "M..." -a "Download-Modified" -u $uName -d $desc -mod $modified -birth $created -acc $accessed }
            
            $d += [pscustomobject]@{
                User         = $uName
                FileName     = $_.Name
                SizeBytes    = $_.Length
                CreatedTime  = $created
                ModifiedTime = $modified
                AccessedTime = $accessed
            }
        }
    }
    $d | ConvertTo-Html -Fragment 
}

