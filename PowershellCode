# Centralized Timestamp Formatting Helper
function Format-DFIRDate($d){
    if ($null -eq $d -or $d -eq "" -or $d -eq "N/A") { return "N/A" }
    try {
        $dtObj = if ($d -is [datetime]) { $d } else { [datetime]::Parse($d.ToString()) }
        if ($dtObj.Year -lt 2000 -or $dtObj.Year -gt 2035) { return "N/A" }
        return $dtObj.ToString("yyyy-MM-dd HH:mm:ss")
    } catch { return "N/A" }
}

# Centralized Super Timeline Memory Engine with Exact Requested Columns
$timeline = [System.Collections.Generic.List[PSObject]]::new()

function Add-TL($t, $macb, $a, $u, $d, $mod="N/A", $acc="N/A", $chg="N/A", $birth="N/A", $lastRun="N/A", $nextRun="N/A"){
    $formattedStr = Format-DFIRDate $t
    if ($formattedStr -eq "N/A") { return }
    $cleanDetails = ($d -replace "[\r\n]+"," " -replace '"', '""').Trim()
    
    $timeline.Add([pscustomobject]@{
        "Timestamp"  = $formattedStr
        "MACB"       = $macb
        "Modified"   = Format-DFIRDate $mod
        "Access"     = Format-DFIRDate $acc
        "Change"     = Format-DFIRDate $chg
        "Birth"      = Format-DFIRDate $birth
        "Artifact"   = $a
        "User"       = if($u){$u}else{"N/A"}
        "Details"    = $cleanDetails
        "Last Run"   = Format-DFIRDate $lastRun
        "Next Run"   = Format-DFIRDate $nextRun
    })
}

