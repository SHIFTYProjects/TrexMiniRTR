function G-E($n){ 
    G-H "Events_$n" { 
        $ev = Get-EventLog -LogName $n -Newest 1000 -EA 0
        $res = $ev | % {
            $tGen = Format-DFIRDate $_.TimeGenerated
            Add-TL -t $tGen -macb "M..." -a "EventLog-$n" -u "N/A" -d "ID: $($_.EventID) | $($_.Message)" -mod $tGen
            [pscustomobject]@{ TimeGenerated=$tGen; EventID=$_.EventID; Message=$_.Message }
        }
        $res | ConvertTo-Html -Fragment 
    } 
}
