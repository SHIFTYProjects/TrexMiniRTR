# Task Scheduler - Independent Last Run / Next Run Dates
G-H "Tasks" { 
    $t = Get-ScheduledTask | % {
        $i = $_ | Get-ScheduledTaskInfo -EA 0
        $lastRun = Format-DFIRDate $i.LastRunTime
        $nextRun = Format-DFIRDate $i.NextRunTime
        
        if($lastRun -ne "N/A"){ 
            Add-TL -t $lastRun -macb "M..." -a "ScheduledTask" -u "SYSTEM" -d "$($_.TaskName) (State: $($_.State))" -mod $lastRun -lastRun $lastRun -nextRun $nextRun 
        }
        
        [pscustomobject]@{
            TaskName    = $_.TaskName
            State       = $_.State
            LastRunTime = $lastRun
            NextRunTime = $nextRun
            TaskPath    = $_.TaskPath
        }
    }
    $t | ConvertTo-Html -Fragment 
}

